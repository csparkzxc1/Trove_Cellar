# Copy to .env.local and fill in. Anything prefixed EXPO_PUBLIC_ is bundled
# into the app and visible at runtime — never put server secrets here.

# === Supabase (Phase 2 wiring) =============================================
# Without these, the app uses the local Zustand stores and seed catalog.
# Apply supabase/migrations/0001_init.sql + seed.sql to the project first.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# === Claude Vision (label OCR) =============================================
# Without this, identifyLabel() returns a deterministic stub guess.
# Get a key at https://console.anthropic.com — model: claude-opus-4-7
EXPO_PUBLIC_ANTHROPIC_API_KEY=
